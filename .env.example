# API Configuration
# Base host for the fieldops backend (no trailing /api, no trailing slash) —
# used for REST calls, the /uploads/** static file host, and the
# /ws/notifications WebSocket (http(s):// is rewritten to ws(s):// at runtime).
REACT_APP_API_URL=http://localhost:8080
REACT_APP_AI_URL=http://localhost:5000/api/ai

# App Configuration
REACT_APP_NAME=SLT Field Operations
REACT_APP_VERSION=1.0.0
